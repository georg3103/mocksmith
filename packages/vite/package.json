{
  "name": "@mocksmith/vite",
  "version": "0.3.2",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "George Mkrtchyan",
  "engines": {
    "node": ">=20.19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/georg3103/mocksmith.git",
    "directory": "packages/vite"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Vite plugins for mocksmith: start the mock server with the dev server, reload the browser on demand, hand out collision-free ports.",
  "keywords": [
    "mocksmith",
    "vite",
    "vite-plugin",
    "mock",
    "testing"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "detect-port": "^1.6.1"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "devDependencies": {
    "@types/detect-port": "^1.3.5",
    "@types/node": "^22.10.0",
    "vite": "^6.0.0"
  }
}
